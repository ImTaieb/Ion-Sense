{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ion Sense",
  "version": "0.1.0",
  "identifier": "com.ionsense.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "hud",
        "title": "Ion Sense",
        "url": "hud-prototype.html",
        "width": 1280,
        "height": 720,
        "backgroundColor": [0, 0, 0, 0],
        "visible": false,
        "closable": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false,
        "focus": false,
        "focusable": false
      },
      {
        "label": "settings",
        "title": "Ion Sense Settings",
        "url": "settings.html",
        "width": 430,
        "height": 720,
        "minWidth": 430,
        "minHeight": 640,
        "maxWidth": 430,
        "maxHeight": 820,
        "visible": false,
        "center": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": true,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
